@model InvestigacionViewModel

@{
    ViewData["Title"] = "Sala 2 - Investigación de Directorio";
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
        background: #0a0e27;
        color: #fff;
        font-family: 'Courier New', monospace;
    }

    .sala-container {
        background: #0a0e27;
        min-height: 100vh;
        padding: 30px;
    }

    .sala-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 30px;
        background: #0f1535;
        border: 3px solid #00ff88;
        border-radius: 2px;
        box-shadow: 0 0 30px rgba(0, 255, 136, 0.4), inset 0 0 20px rgba(0, 255, 136, 0.1);
        position: relative;
    }

    .sala-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #00ff88, transparent);
        animation: neonFlicker 3s infinite;
    }

    .sala-header h1 {
        font-size: 2.5em;
        margin-bottom: 8px;
        color: #00ff88;
        text-shadow: 0 0 20px rgba(0, 255, 136, 0.8), 0 0 40px rgba(0, 255, 136, 0.4);
        letter-spacing: 3px;
        font-weight: 900;
    }

    .sala-header p {
        color: #00ccff;
        font-size: 0.95em;
        text-shadow: 0 0 10px rgba(0, 204, 255, 0.6);
        letter-spacing: 2px;
    }

    /* MODAL */
    .modal {
        display: flex;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background: #0f1535;
        padding: 50px;
        border: 3px solid #ff0055;
        border-radius: 2px;
        max-width: 600px;
        width: 90%;
        box-shadow: 0 0 40px rgba(255, 0, 85, 0.6), inset 0 0 30px rgba(255, 0, 85, 0.1);
        text-align: center;
        position: relative;
    }

    .modal-content::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #ff0055, transparent);
        animation: neonFlicker 2s infinite;
    }

    .modal-header {
        font-size: 2em;
        color: #ff0055;
        font-weight: 900;
        margin-bottom: 25px;
        letter-spacing: 2px;
        text-shadow: 0 0 20px rgba(255, 0, 85, 0.8);
    }

    .modal-body {
        color: #00ffff;
        font-size: 1.05em;
        line-height: 1.8;
        margin-bottom: 30px;
        text-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
    }

    .modal-body strong {
        color: #ffaa00;
        text-shadow: 0 0 15px rgba(255, 170, 0, 0.6);
    }

    .modal-button {
        background: #1a0033;
        color: #ff0055;
        border: 2px solid #ff0055;
        padding: 16px 50px;
        font-size: 1.1em;
        font-weight: 900;
        cursor: pointer;
        border-radius: 2px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 2px;
        box-shadow: 0 0 20px rgba(255, 0, 85, 0.4);
    }

    .modal-button:hover {
        background: #ff0055;
        color: #0f1535;
        box-shadow: 0 0 40px rgba(255, 0, 85, 0.8);
        transform: translate(0, -3px);
    }

    .modal.hidden {
        display: none;
    }

    /* CONTENIDO PRINCIPAL */
    .investigacion-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-bottom: 30px;
    }

    .panel {
        background: #0f1535;
        border: 2px solid #00ff88;
        border-radius: 2px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
        position: relative;
        transition: all 0.3s ease;
    }

    .panel:hover {
        box-shadow: 0 0 40px rgba(0, 255, 136, 0.6);
    }

    .panel::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #00ff88, transparent);
        animation: neonFlicker 4s infinite;
    }

    .panel-header {
        background: #1a0033;
        color: #ffaa00;
        padding: 18px 25px;
        font-weight: 900;
        font-size: 1.15em;
        letter-spacing: 2px;
        border-bottom: 2px solid #00ff88;
        text-shadow: 0 0 15px rgba(255, 170, 0, 0.6);
    }

    .panel-body {
        padding: 20px;
        max-height: 500px;
        overflow-y: auto;
        background: linear-gradient(180deg, rgba(15, 21, 53, 1), rgba(10, 14, 39, 1));
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9em;
    }

    th {
        background: #1a0033;
        color: #00ffff;
        padding: 12px;
        text-align: left;
        font-weight: 900;
        border-bottom: 2px solid #00ff88;
        text-transform: uppercase;
        font-size: 0.85em;
        letter-spacing: 1px;
        text-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
    }

    td {
        padding: 10px 12px;
        border-bottom: 1px solid rgba(0, 255, 136, 0.2);
        color: #00ffff;
    }

    tr:hover {
        background: rgba(0, 255, 136, 0.15);
        box-shadow: inset 0 0 10px rgba(0, 255, 136, 0.2);
    }

    .nivel-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 2px;
        font-weight: 900;
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .nivel-2 {
        background: #1a0033;
        color: #ff0055;
        border: 1px solid #ff0055;
        box-shadow: 0 0 10px rgba(255, 0, 85, 0.5);
    }

    .nivel-1 {
        background: #1a1a00;
        color: #ffaa00;
        border: 1px solid #ffaa00;
        box-shadow: 0 0 10px rgba(255, 170, 0, 0.5);
    }

    .nivel-0 {
        background: #0a1a1a;
        color: #00ccff;
        border: 1px solid #00ccff;
        box-shadow: 0 0 10px rgba(0, 204, 255, 0.5);
    }

    /* FORMULARIO */
    .validacion-form {
        background: #0f1535;
        border: 3px solid #00ccff;
        border-radius: 2px;
        padding: 35px;
        text-align: center;
        box-shadow: 0 0 30px rgba(0, 204, 255, 0.4), inset 0 0 20px rgba(0, 204, 255, 0.1);
        position: relative;
    }

    .validacion-form::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #00ccff, transparent);
        animation: neonFlicker 2.5s infinite;
    }

    .validacion-form h3 {
        font-size: 1.8em;
        margin-bottom: 25px;
        color: #00ccff;
        letter-spacing: 2px;
        text-shadow: 0 0 20px rgba(0, 204, 255, 0.8);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        color: #00ff88;
        font-weight: 900;
        margin-bottom: 10px;
        text-transform: uppercase;
        font-size: 0.9em;
        letter-spacing: 1px;
        text-shadow: 0 0 10px rgba(0, 255, 136, 0.6);
    }

    .form-input {
        width: 100%;
        padding: 14px;
        background: #0a0e27;
        border: 2px solid #00ff88;
        color: #00ffff;
        font-size: 1em;
        border-radius: 2px;
        font-family: 'Courier New', monospace;
        transition: all 0.3s ease;
        text-shadow: 0 0 5px rgba(0, 255, 255, 0.4);
        box-shadow: inset 0 0 10px rgba(0, 255, 136, 0.1);
    }

    .form-input:focus {
        outline: none;
        border-color: #00ccff;
        box-shadow: inset 0 0 10px rgba(0, 204, 255, 0.2), 0 0 20px rgba(0, 204, 255, 0.5);
    }

    .form-input::placeholder {
        color: rgba(0, 255, 255, 0.4);
    }

    .form-button {
        background: #1a0033;
        color: #00ccff;
        border: 2px solid #00ccff;
        padding: 16px 50px;
        font-size: 1.1em;
        font-weight: 900;
        cursor: pointer;
        border-radius: 2px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 2px;
        box-shadow: 0 0 20px rgba(0, 204, 255, 0.4);
    }

    .form-button:hover {
        background: #00ccff;
        color: #0f1535;
        box-shadow: 0 0 40px rgba(0, 204, 255, 0.8);
        transform: translate(0, -3px);
    }

    .form-button:active {
        transform: translate(0, 0);
    }

    .error-message {
        background: rgba(255, 0, 85, 0.15);
        border: 2px solid #ff0055;
        color: #ff6688;
        padding: 18px;
        border-radius: 2px;
        margin-top: 20px;
        text-align: left;
        box-shadow: 0 0 15px rgba(255, 0, 85, 0.3);
        text-shadow: 0 0 10px rgba(255, 0, 85, 0.4);
        font-weight: 700;
    }

    .scanning {
        color: #00ff88;
        font-weight: 900;
        animation: pulse 1.5s infinite;
        text-shadow: 0 0 15px rgba(0, 255, 136, 0.8);
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; text-shadow: 0 0 15px rgba(0, 255, 136, 0.8); }
        50% { opacity: 0.6; text-shadow: 0 0 5px rgba(0, 255, 136, 0.3); }
    }

    @@keyframes neonFlicker {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    /* SCROLLBAR */
    .panel-body::-webkit-scrollbar {
        width: 10px;
    }

    .panel-body::-webkit-scrollbar-track {
        background: #0a0e27;
    }

    .panel-body::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #00ff88, #00ccff);
        border-radius: 2px;
        box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
    }

    .panel-body::-webkit-scrollbar-thumb:hover {
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.8);
    }
</style>

<div class="sala-container">
    <!-- MODAL DE HISTORIA -->
    <div id="modalhHistory" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                ⚠ FASE 2: IDENTIFICAR AL INFILTRADO
            </div>
            <div class="modal-body">
                Un usuario con <strong>privilegios de Nivel 2</strong> saboteó el sistema a la madrugada. 
                <br><br>
                Cruzá los registros de auditoría con el directorio de empleados para encontrar el <strong>legajo del culpable</strong>.
                <br><br>
                <em>Busca pistas en los logs: quién accedió y cuándo.</em>
            </div>
            <button class="modal-button" onclick="cerrarModal()">Iniciar Escaneo</button>
        </div>
    </div>

    <!-- ENCABEZADO -->
    <div class="sala-header">
        <h1>SISTEMA DE GESTIÓN DE DIRECTORIO</h1>
        <p>Auditoría de Seguridad - Investigación de Infiltración</p>
    </div>

    <!-- PANELES DE DATOS -->
    <div class="investigacion-grid">
        <!-- PANEL DE EMPLEADOS -->
        <div class="panel">
            <div class="panel-header">📋 DIRECTORIO DE EMPLEADOS</div>
            <div class="panel-body">
                <table>
                    <thead>
                        <tr>
                            <th>Legajo</th>
                            <th>Nombre</th>
                            <th>Rol</th>
                            <th>Nivel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Empleados)
                        {
                            <tr>
                                <td><strong>@emp.Legajo</strong></td>
                                <td>@emp.Nombre</td>
                                <td>@emp.NombreRol</td>
                                <td>
                                    <span class="nivel-badge nivel-@emp.NivelAcceso">
                                        @emp.NivelAcceso
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PANEL DE LOGS -->
        <div class="panel">
            <div class="panel-header">📊 LOGS DE AUDITORÍA</div>
            <div class="panel-body">
                <table>
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>ID Empleado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>@log.FechaHora.ToString("HH:mm:ss")</td>
                                <td><strong>@log.EmpleadoId</strong></td>
                                <td>@log.Accion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- FORMULARIO DE VALIDACIÓN -->
    <div class="validacion-form">
        <h3>VALIDAR CREDENCIAL DE ADMINISTRADOR</h3>
        
        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                <strong>❌ ERROR:</strong> @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="ValidarSospechoso" asp-controller="Directorio">
            <div class="form-group">
                <label class="form-label">Ingresá el legajo del culpable (Supervisor Nivel 2):</label>
                <input type="text" name="legajo" class="form-input" placeholder="Ej: EMP-001" required>
            </div>

            <button type="submit" class="form-button">Validar Credencial</button>
        </form>
    </div>
</div>

<script>
    // Mostrar modal automáticamente al cargar
    window.addEventListener('DOMContentLoaded', function() {
        mostrarModal();
    });

    function cerrarModal() {
        const modal = document.getElementById('modalhHistory');
        modal.classList.add('hidden');
    }

    function mostrarModal() {
        const modal = document.getElementById('modalhHistory');
        modal.classList.remove('hidden');
    }

    // Cerrar modal si se presiona ESC (opcional)
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            cerrarModal();
        }
    });
</script>
