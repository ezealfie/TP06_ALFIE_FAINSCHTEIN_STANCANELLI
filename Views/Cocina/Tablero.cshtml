@model List<Pedidos>

@{
    ViewData["Title"] = "La Cocina Maldita - Tablero de Pedidos";
    var random = new Random();
    var pedidosAleatorios = Model.OrderBy(x => random.Next()).ToList();
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
        background: #1a1a1a url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60"><rect fill="%23222" width="60" height="60"/><line x1="0" y1="30" x2="60" y2="30" stroke="%23333" stroke-width="0.5"/></svg>');
        color: #fff;
        font-family: 'Courier New', monospace;
        overflow-x: hidden;
    }

    .kds-container {
        background: #1a1a1a;
        min-height: 100vh;
        padding: 20px;
        position: relative;
        overflow: hidden;
    }

    .kds-container::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(
            0deg,
            rgba(255, 100, 0, 0.02) 0px,
            rgba(255, 100, 0, 0.02) 1px,
            transparent 1px,
            transparent 2px
        );
        pointer-events: none;
        z-index: 1;
        animation: flameFlicker 0.15s infinite;
    }

    @@keyframes flameFlicker {
        0%, 100% { opacity: 0.95; }
        50% { opacity: 0.98; }
    }

    .kds-header {
        position: relative;
        z-index: 2;
        margin-bottom: 25px;
        padding: 25px;
        background: linear-gradient(135deg, #2d1810 0%, #1a0f0a 100%);
        border: 3px solid #ff4500;
        border-radius: 0px;
        box-shadow: 
            0 0 30px rgba(255, 69, 0, 0.4),
            inset 0 0 20px rgba(0, 0, 0, 0.9);
        animation: borderGlow 2s ease-in-out infinite;
    }

    @@keyframes borderGlow {
        0%, 100% {
            box-shadow: 
                0 0 30px rgba(255, 69, 0, 0.4),
                inset 0 0 20px rgba(0, 0, 0, 0.9);
        }
        50% {
            box-shadow: 
                0 0 50px rgba(255, 69, 0, 0.7),
                inset 0 0 20px rgba(0, 0, 0, 0.9),
                0 0 80px rgba(255, 140, 0, 0.3);
        }
    }

    .kds-header h1 {
        font-size: 2.2em;
        color: #ff6b35;
        letter-spacing: 3px;
        font-weight: bold;
        margin-bottom: 8px;
        text-shadow: 
            0 0 20px rgba(255, 107, 53, 0.8),
            0 0 40px rgba(255, 69, 0, 0.4);
        animation: flameGlow 1.5s ease-in-out infinite;
    }

    @@keyframes flameGlow {
        0%, 100% {
            text-shadow: 
                0 0 20px rgba(255, 107, 53, 0.8),
                0 0 40px rgba(255, 69, 0, 0.4);
        }
        50% {
            text-shadow: 
                0 0 30px rgba(255, 140, 0, 1),
                0 0 60px rgba(255, 69, 0, 0.6);
        }
    }

    .kds-header p {
        color: #ffaa33;
        font-size: 1em;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .kitchen-stats {
        display: flex;
        justify-content: space-around;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 2px solid #ff4500;
        gap: 20px;
    }

    .stat-box {
        text-align: center;
        flex: 1;
        padding: 10px;
        background: rgba(255, 69, 0, 0.05);
        border: 1px solid rgba(255, 69, 0, 0.2);
    }

    .stat-value {
        font-size: 1.6em;
        color: #ffaa33;
        font-weight: bold;
        animation: counterPulse 1s ease-in-out infinite;
    }

    @@keyframes counterPulse {
        0%, 100% { font-size: 1.6em; }
        50% { font-size: 1.7em; }
    }

    .stat-label {
        font-size: 0.75em;
        color: #cc7722;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 4px;
    }

    .message-alert {
        position: relative;
        z-index: 2;
        margin-bottom: 20px;
        padding: 15px 20px;
        border-radius: 0px;
        border-left: 5px solid;
        font-weight: 600;
        animation: alertPulse 0.5s ease-out;
    }

    @@keyframes alertPulse {
        0% { opacity: 0; transform: translateY(-10px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    .message-alert.success {
        background: rgba(76, 255, 0, 0.1);
        border-left-color: #4cff00;
        color: #4cff00;
        box-shadow: 0 0 15px rgba(76, 255, 0, 0.3);
    }

    .message-alert.danger {  
        background: rgba(255, 51, 51, 0.1);
        border-left-color: #ff3333;
        color: #ff3333;
        box-shadow: 0 0 15px rgba(255, 51, 51, 0.3);
    }

    .message-alert.warning {
        background: rgba(255, 170, 51, 0.1);
        border-left-color: #ffaa33;
        color: #ffaa33;
        box-shadow: 0 0 15px rgba(255, 170, 51, 0.3);
    }

    .pedidos-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
    }

    .ticket-card {
        background: linear-gradient(135deg, rgba(40, 20, 10, 0.95) 0%, rgba(25, 12, 5, 0.95) 100%);
        border: 2px solid #ff6b35;
        border-radius: 2px;
        padding: 16px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        box-shadow: 
            0 0 15px rgba(255, 107, 53, 0.2),
            inset 0 0 10px rgba(0, 0, 0, 0.6);
    }

    .ticket-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #ff6b35 0%, #ffaa33 50%, #ff6b35 100%);
        animation: fireFlare 1.2s ease-in-out infinite;
    }

    @@keyframes fireFlare {
        0%, 100% { opacity: 0.7; height: 3px; }
        50% { opacity: 1; height: 4px; }
    }

    .ticket-card:hover {
        border-color: #ffaa33;
        box-shadow: 
            0 0 30px rgba(255, 170, 51, 0.5),
            inset 0 0 10px rgba(0, 0, 0, 0.6);
        transform: translateY(-3px) scale(1.02);
        background: linear-gradient(135deg, rgba(50, 30, 15, 0.95) 0%, rgba(35, 18, 8, 0.95) 100%);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255, 107, 53, 0.3);
    }

    .ticket-number {
        font-size: 1.8em;
        color: #ffaa33;
        font-weight: 700;
        letter-spacing: 2px;
        font-family: 'Courier New', monospace;
        animation: numberPulse 1.5s ease-in-out infinite;
    }

    @@keyframes numberPulse {
        0%, 100% { color: #ffaa33; }
        50% { color: #ff6b35; }
    }

    .ticket-detail {
        color: #ddd;
        margin: 10px 0;
        font-size: 0.9em;
        line-height: 1.5;
        word-wrap: break-word;
    }

    .ticket-detail strong {
        color: #ffaa33;
        font-weight: 600;
    }

    .ticket-notes {
        color: #999;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 107, 53, 0.2);
        font-size: 0.85em;
        font-style: italic;
    }

    .checkbox-wrapper {
        margin: 12px 0 0 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-top: 1px solid rgba(255, 107, 53, 0.2);
    }

    .checkbox-wrapper input[type="checkbox"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: #ff6b35;
    }

    .checkbox-wrapper label {
        color: #ffaa33;
        font-weight: 600;
        cursor: pointer;
        margin: 0;
        font-size: 0.9em;
    }

    .button-container {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 30px;
    }

    .purga-button {
        background: linear-gradient(135deg, #ff4500 0%, #cc3300 100%);
        color: #fff;
        border: 3px solid #ffaa33;
        padding: 20px 60px;
        font-size: 1.2em;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        letter-spacing: 2px;
        cursor: pointer;
        border-radius: 0px;
        box-shadow: 
            0 0 25px rgba(255, 69, 0, 0.5),
            inset 0 0 15px rgba(255, 170, 51, 0.1);
        transition: all 0.3s ease;
        text-transform: uppercase;
        animation: buttonHeat 2s ease-in-out infinite;
    }

    @@keyframes buttonHeat {
        0%, 100% {
            box-shadow: 
                0 0 25px rgba(255, 69, 0, 0.5),
                inset 0 0 15px rgba(255, 170, 51, 0.1);
        }
        50% {
            box-shadow: 
                0 0 40px rgba(255, 140, 0, 0.8),
                inset 0 0 20px rgba(255, 170, 51, 0.2);
        }
    }

    .purga-button:hover {
        background: linear-gradient(135deg, #cc3300 0%, #990000 100%);
        box-shadow: 
            0 0 50px rgba(255, 140, 0, 0.9),
            inset 0 0 20px rgba(255, 170, 51, 0.3);
        transform: translateY(-4px) scale(1.05);
        border-color: #ffdd00;
    }

    .purga-button:active {
        transform: translateY(-1px) scale(0.98);
    }

    .modal {
        display: flex;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background: #1a0f0a;
        padding: 50px;
        border: 3px solid #ff4500;
        border-radius: 2px;
        max-width: 650px;
        width: 90%;
        box-shadow: 0 0 40px rgba(255, 69, 0, 0.6), inset 0 0 30px rgba(255, 69, 0, 0.1);
        text-align: center;
        position: relative;
    }

    .modal-content::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #ff4500, transparent);
        animation: flameFlicker 2s infinite;
    }

    .modal-header {
        font-size: 2em;
        color: #ff6b35;
        font-weight: 900;
        margin-bottom: 25px;
        letter-spacing: 2px;
        text-shadow: 0 0 20px rgba(255, 107, 53, 0.8);
    }

    .modal-body {
        color: #f7d9b8;
        font-size: 1.05em;
        line-height: 1.8;
        margin-bottom: 30px;
        text-shadow: 0 0 10px rgba(255, 170, 51, 0.4);
    }

    .modal-body strong {
        color: #ffaa33;
        text-shadow: 0 0 15px rgba(255, 170, 51, 0.6);
    }

    .modal-button {
        background: #2d1810;
        color: #ff6b35;
        border: 2px solid #ff6b35;
        padding: 16px 50px;
        font-size: 1.1em;
        font-weight: 900;
        cursor: pointer;
        border-radius: 2px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 2px;
        box-shadow: 0 0 20px rgba(255, 69, 0, 0.4);
    }

    .modal-button:hover {
        background: #ff4500;
        color: #1a0f0a;
        box-shadow: 0 0 40px rgba(255, 69, 0, 0.8);
        transform: translate(0, -3px);
    }

    .modal.hidden {
        display: none;
    }
</style>

<div class="kds-container">
    <div id="modalhHistory" class="modal" style="display: flex;">
        <div class="modal-content">
            <div class="modal-header">
                ALERTA DE SEGURIDAD
            </div>
            <div class="modal-body">
                El sistema informático de la hamburguesería fue comprometido por un ataque interno.
                <br><br>
                Tu primera misión es estabilizar el Monitor de Cocina (KDS) purgando los pedidos infectados.
            </div>
            <button class="modal-button" onclick="cerrarModal()">Acceder a la Cocina</button>
        </div>
    </div>

    <div class="kds-header">
        <h1>🔥 COCINA INDUSTRIAL 🔥</h1>
        <p>TABLERO DE ÓRDENES EN VIVO</p>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="message-alert @(ViewBag.TipoMensaje == "danger" ? "danger" : ViewBag.TipoMensaje == "warning" ? "warning" : "success")">
            @ViewBag.Mensaje
        </div>
    }

    <form method="post" asp-action="PurgarSistema" asp-controller="Cocina">
        <div class="pedidos-grid">
            @foreach (var pedido in pedidosAleatorios)
            {
                <div class="ticket-card">
                    <div class="card-header">
                        <div class="ticket-number">
                            #@pedido.TicketNumero.ToString().PadLeft(2, '0')
                        </div>
                    </div>

                    <div class="ticket-detail">
                        <strong>ORDEN:</strong>
                        <div style="margin-top: 4px; font-size: 0.85em;">@pedido.DetalleOrden</div>
                    </div>

                    <div class="ticket-notes">
                        <strong>NOTAS:</strong> @pedido.NotasCliente
                    </div>

                    <div class="checkbox-wrapper">
                        <input type="checkbox" name="ticketsSeleccionados" value="@pedido.Id" id="pedido-@pedido.Id">
                        <label for="pedido-@pedido.Id">
                            MARCAR COMO SOSPECHOSO 🔎
                        </label>
                    </div>
                </div>
            }
        </div>

        <div class="button-container">
            <button type="submit" class="purga-button">
                🔥 PURGAR SISTEMA 🔥
            </button>
        </div>
    </form>
</div>

<script>
    function cerrarModal() {
        var modal = document.getElementById('modalhHistory');
        if (modal) {
            modal.style.display = 'none';
        }
    }

    function mostrarModal() {
        var modal = document.getElementById('modalhHistory');
        if (modal) {
            modal.style.display = 'flex';
        }
    }

    mostrarModal();
</script>
