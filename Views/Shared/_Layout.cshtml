<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP06</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP06.styles.css" asp-append-version="true" />
    <style>
        body {
            background: #0d0d0d;
        }

        header {
            background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%) !important;
            border-bottom: 2px solid rgba(0, 217, 255, 0.3) !important;
            box-shadow: 0 4px 20px rgba(255, 0, 110, 0.1);
        }

        .navbar-brand {
            color: #00d9ff !important;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            font-size: 1.4em;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
        }

        .navbar-brand:hover {
            color: #ff006e !important;
            text-shadow: 0 0 15px rgba(255, 0, 110, 0.7);
        }

        .nav-link {
            color: #bbb !important;
            font-family: 'Courier New', monospace;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            color: #00d9ff !important;
            text-shadow: 0 0 8px rgba(0, 217, 255, 0.6);
        }

        footer {
            background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%) !important;
            border-top: 2px solid rgba(0, 217, 255, 0.3) !important;
            font-family: 'Courier New', monospace;
            color: #666 !important;
        }

        .container {
            background: #0d0d0d;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🔑 LA COCINA MALDITA</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Instrucciones</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - La Cocina Maldita - <a asp-area="" asp-controller="Home" asp-action="Privacy">Instrucciones</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
