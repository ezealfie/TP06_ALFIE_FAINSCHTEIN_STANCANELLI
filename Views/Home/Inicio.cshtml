@{
    ViewData["Title"] = "Inicio";
}

<section class="escape-hero py-5">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-lg-10 col-xl-9">
                <div class="escape-card shadow-lg overflow-hidden">
                    <div class="row g-0">
                        <div class="col-lg-6 escape-info p-5 text-white d-flex flex-column justify-content-center">
                            <span class="badge rounded-pill bg-warning text-dark mb-3 align-self-start">Sala de escape</span>
                            <h1 class="display-5 fw-bold mb-3">Bienvenidos a la sala de escape</h1>
                            <p class="lead mb-4">
                                Ingresá tu nombre, reuní a tu equipo y prepárate para resolver enigmas,
                                descubrir pistas y escapar antes de que se acabe el tiempo.
                            </p>
                            <div class="escape-features">
                                <div class="feature-item">Pistas ocultas</div>
                                <div class="feature-item">Desafíos mentales</div>
                                <div class="feature-item">Trabajo en equipo</div>
                            </div>
                        </div>

                        <div class="col-lg-6 bg-white p-5">
                            <h2 class="h3 fw-semibold mb-3">Comenzar aventura</h2>
                            <p class="text-muted mb-4">Completá tus datos para iniciar la partida.</p>

                            <form method="post" action="@Url.Action("ComenzarJuego", "Home")" class="escape-form">
                                <div class="mb-4">
                                    <label for="nombreJugador" class="form-label fw-semibold">Nombre del jugador</label>
                                    <input type="text" class="form-control form-control-lg" id="nombreJugador" name="nombreJugador" required placeholder="Por ejemplo: Sofía">
                                </div>

                                <input type="hidden" name="fechaHora" value="@DateTime.Now">

                                <button type="submit" class="btn btn-dark btn-lg w-100 py-3">
                                    Iniciar la escape room
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
